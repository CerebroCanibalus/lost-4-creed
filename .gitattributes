# Normalizacion de fin de linea
* text=auto eol=lf

# VScript - forzar LF, sin conversion
*.nut   text eol=lf
*.nuc   text eol=lf

# Source de shaders
*.hlsl  text eol=lf

# PowerShell - CRLF obligatorio (Windows)
*.ps1   text eol=crlf
*.bat   text eol=crlf

# Markdown y config
*.md    text eol=lf
*.cfg   text eol=lf
*.json  text eol=lf

